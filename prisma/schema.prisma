generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Imóveis ───────────────────────────────────────────────────────────────────
model Property {
  id            Int      @id @default(autoincrement())
  code          String?  @unique @db.VarChar(50)
  videoUrl      String?  @db.VarChar(500)
  title         String   @db.VarChar(255)
  description   String   @db.Text
  type          String   @db.VarChar(20)       // RURAL | URBANO
  category      String   @db.VarChar(20)       // Venda | Locação
  purpose       String   @db.VarChar(30)       // Residencial | Comercial | Rural
  city          String   @db.VarChar(100)
  neighborhood  String   @db.VarChar(100)
  state         String   @db.VarChar(2)        // SP, MG, etc.
  price         Decimal  @db.Decimal(12, 2)
  bedrooms      Int      @default(0)
  suites        Int      @default(0)
  bathrooms     Int      @default(0)
  garageSpots   Int      @default(0)
  area          Float
  areaUnit      String   @db.VarChar(10)       // m² | ha | alq
  builtArea     Float?
  builtAreaUnit String?  @db.VarChar(10)
  imageUrl      String   @db.VarChar(500)      // foto de capa
  images        String   @db.Text              // JSON serializado: String[]
  features      String   @db.Text              // JSON serializado: String[]
  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(false)
  acceptsExchange Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([category])
  @@index([type])
  @@index([isPublished])
}

// ─── Depoimentos ──────────────────────────────────────────────────────────────
model Review {
  id          Int      @id @default(autoincrement())
  clientName  String   @db.VarChar(100)
  content     String   @db.Text
  rating      Int      @default(5)
  imageUrl    String?  @db.VarChar(500)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── Opções dinâmicas dos dropdowns ──────────────────────────────────────────
model PropertyOption {
  id        Int      @id @default(autoincrement())
  field     String   @db.VarChar(20)    // 'category' | 'type' | 'purpose'
  label     String   @db.VarChar(100)
  value     String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@unique([field, value])
  @@index([field])
}


model AdminUser {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String    @db.VarChar(255)     // bcrypt hash — nunca texto puro
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
}

// ─── Acessos / Analytics ──────────────────────────────────────────────────────
model PageView {
  id          Int      @id @default(autoincrement())
  path        String   @db.VarChar(191)        // 191 = limite seguro p/ UTF-8 + índice MySQL
  visitedAt   DateTime @default(now())

  @@index([visitedAt])
  @@index([path])
}

// ─── Página Sobre Nós ─────────────────────────────────────────────────────────
model AboutPage {
  id              Int      @id @default(autoincrement())

  // Hero
  heroTitle       String   @db.VarChar(200)
  heroSubtitle    String   @db.VarChar(500)
  bannerImageUrl  String?  @db.VarChar(500)

  // História
  historyText     String   @db.Text
  historyImageUrl String?  @db.VarChar(500)

  // Missão / Visão / Valores
  missionText     String   @db.Text
  visionText      String   @db.Text
  valuesText      String   @db.Text             // JSON serializado: { title, text }[]

  // Álvares Florence
  cityName        String   @db.VarChar(100)
  cityText        String   @db.Text
  cityImageUrl    String?  @db.VarChar(500)

  // Corretor Responsável
  agentName       String   @db.VarChar(100)
  agentCreci      String   @db.VarChar(50)
  agentPhone      String   @db.VarChar(30)
  agentWhatsapp   String   @db.VarChar(200)
  agentImageUrl   String?  @db.VarChar(500)
  agentBio        String?  @db.Text

  updatedAt       DateTime @updatedAt
}
